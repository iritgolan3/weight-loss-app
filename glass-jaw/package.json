{
  "name": "glass-jaw",
  "version": "1.0.0",
  "private": true,
  "description": "GLASS JAW - a modern high-resolution arcade boxing game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-tests.mjs",
    "playtest": "node tools/playtest.mjs",
    "standalone": "node tools/build-standalone.mjs && node tools/verify-standalone.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "playwright": "^1.48.0"
  }
}
